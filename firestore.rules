rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Πρόσβαση έχουν μόνο όσοι έχουν έγγραφο staff/{uid} (τους προσθέτει ο διαχειριστής μέσα από την εφαρμογή).
    function signedIn() { return request.auth != null; }
    function isStaff()  { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isAdmin()  { return isStaff() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.admin == true; }
    // επικεφαλής = διαχειριστής ή staff με role == 'head' (μόνο αυτοί γράφουν οχήματα/χάρτες)
    function isHead()   { return isStaff() && (get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.admin == true || get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('role', '') == 'head'); }
    function noInit()   { return !exists(/databases/$(database)/documents/meta/init); }
    function isOwner()  { return signedIn() && request.auth.token.email == 'ADMIN_EMAIL'; }   // αντικαθίσταται από το auth-setup.sh

    match /vehicles/{id} {
      allow read: if isStaff();
      allow write: if isHead();
      // οι υπάλληλοι μπορούν να καταχωρούν νέα οχήματα και να δηλώνουν έξοδο
      allow create: if isStaff();
      // (έξοδος) αλλάζουν μόνο exitAt/exitBy (αλλάζουν μόνο exitAt/exitBy)
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exitAt', 'exitBy']);
    }
    match /maps/{id}     { allow read: if isStaff(); allow write: if isHead(); }

    match /staff/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isStaff());
      // πρώτος διαχειριστής (μία φορά, μόνο το email του ιδιοκτήτη) ή οποιοσδήποτε διαχειριστής
      allow create: if isAdmin() || (isOwner() && request.auth.uid == uid && request.resource.data.admin == true && noInit());
      allow update, delete: if isAdmin();
    }
    match /meta/{d} {
      allow read: if signedIn();
      allow create: if d == 'init' && isOwner() && noInit();
    }
  }
}
