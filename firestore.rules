rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Πρόσβαση έχουν μόνο όσοι έχουν έγγραφο staff/{uid} (τους προσθέτει ο διαχειριστής μέσα από την εφαρμογή).
    function signedIn() { return request.auth != null; }
    function isStaff()  { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    // κάθε επικεφαλής είναι και διαχειριστής (μπορεί να προσθέτει/αφαιρεί προσωπικό)
    function isAdmin()  { return isStaff() && (get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.admin == true || get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('role', '') == 'head'); }
    // επικεφαλής = διαχειριστής ή staff με role == 'head' (μόνο αυτοί γράφουν οχήματα/χάρτες)
    function isHead()   { return isStaff() && (get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.admin == true || get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('role', '') == 'head'); }
    function noInit()   { return !exists(/databases/$(database)/documents/meta/init); }
    function isOwner()  { return signedIn() && request.auth.token.email == 'ADMIN_EMAIL'; }   // αντικαθίσταται από το auth-setup.sh

    match /vehicles/{id} {
      allow read: if isStaff();
      allow write: if isHead();
      // οι υπάλληλοι μπορούν να καταχωρούν νέα οχήματα και να δηλώνουν έξοδο
      allow create: if isStaff();
      // (έξοδος / παρκάρισμα) αλλάζουν μόνο exitAt/exitBy ή θέση (location/mapId/parkedBy/parkedAt)
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exitAt', 'exitBy', 'location', 'mapId', 'parkedBy', 'parkedAt']);
    }
    // αιτήματα «χρειάζεται το όχημα»: δημιουργεί/ακυρώνει ο επικεφαλής, οι υπάλληλοι μόνο τα σημειώνουν ως αναληφθέντα
    match /requests/{id} {
      allow read: if isStaff();
      allow create, delete: if isHead();
      allow update: if isStaff() && resource.data.doneAt == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneAt', 'doneBy']);
    }
    match /maps/{id}     { allow read: if isStaff(); allow write: if isHead(); }

    match /staff/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isStaff());
      // πρώτος διαχειριστής (μία φορά, μόνο το email του ιδιοκτήτη) ή οποιοσδήποτε διαχειριστής
      allow create: if isAdmin() || (isOwner() && request.auth.uid == uid && request.resource.data.admin == true && noInit());
      allow update, delete: if isAdmin();
    }
    match /meta/{d} {
      allow read: if signedIn();
      allow create: if d == 'init' && isOwner() && noInit();
    }

    // σελίδα πελάτη: κάθε όχημα έχει ένα μυστικό link (links/{κωδικός}). Διαβάζεται μόνο με τον κωδικό (όχι λίστα).
    // Ο πελάτης μπορεί να γράψει ΜΟΝΟ askAt (ώρα διακομιστή), το πολύ μία φορά ανά 2 λεπτά, και όχι όταν το όχημα έχει φύγει.
    match /links/{t} {
      allow get: if true;
      allow list: if false;
      allow create: if isStaff();
      allow delete: if isHead();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['askAt'])
                    && request.resource.data.askAt == request.time
                    && resource.data.get('st', '') != 'out'
                    && (resource.data.get('askAt', null) == null || request.time > resource.data.askAt + duration.value(2, 'm'));
    }
    match /pushTokens/{t} {
      allow read: if isHead();
      allow create, update: if isStaff() && request.resource.data.uid == request.auth.uid;
      allow delete: if isStaff();
    }
  }
}
